// Streams: the right panel (people in our channel, streams, requests to
// watch ours) and the viewer.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Bridge, StreamItem, MemberItem } from "../bridge.slint";
import { Nav } from "../nav.slint";
import { Icon, Button, ButtonKind, IconButton, Avatar, Status, LiveBadge, Chip, Select, SectionHeader, SpeakingBars, Slider, Spinner, TextField, ListView, ScrollView } from "../components/index.slint";
import { MemberRow, GroupHeader } from "members.slint";
import { MessageRow } from "chat.slint";

// A stream card: the streamer, the title, watch / show / leave.
component StreamCard inherits Rectangle {
    in property <StreamItem> stream;
    border-radius: Theme.radius-lg;
    background: stream.watching ? Theme.accent-soft : Theme.surface-2;
    border-width: 1px;
    border-color: stream.watching ? Theme.accent : Theme.border;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: stream.name;
    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;
        HorizontalLayout {
            spacing: Theme.space-3;
            // A picture-less preview: the live mark on a gradient.
            Rectangle {
                width: 64px;
                height: 40px;
                border-radius: Theme.radius-sm;
                background: @linear-gradient(135deg, #2b1f6e 0%, #0f2a66 100%);
                Icon {
                    source: Icons.monitor-up;
                    size: Theme.icon-md;
                    tint: #ffffffc0;
                }
                if stream.id != "": LiveBadge {
                    x: 3px;
                    y: 3px;
                    height: 14px;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: stream.id == "" ? @tr("{} is streaming", stream.streamer) : stream.name == "" ? @tr("Untitled stream") : stream.name;
                    color: Theme.text;
                    font-weight: Theme.weight-semibold;
                    overflow: elide;
                }
                Text {
                    text: stream.id == "" ? @tr("Started before you joined; looking it up…") : stream.own ? @tr("your stream") : stream.audio ? @tr("by {} · with sound", stream.streamer) : @tr("by {}", stream.streamer);
                    color: Theme.text-muted;
                    font-size: Theme.font-sm;
                    overflow: elide;
                }
            }
        }
        if stream.id != "" && !stream.own: HorizontalLayout {
            spacing: Theme.space-2;
            if !stream.watching: Button {
                horizontal-stretch: 1;
                small: true;
                kind: ButtonKind.primary;
                icon: Icons.eye;
                text: @tr("Watch");
                accessible-label: @tr("Watch {}", stream.name);
                clicked => { Bridge.watch-stream(stream.id); }
            }
            if stream.watching && !Bridge.viewer-open: Button {
                horizontal-stretch: 1;
                small: true;
                icon: Icons.monitor;
                text: @tr("Show");
                clicked => { Bridge.show-viewer(); }
            }
            if stream.watching: Button {
                horizontal-stretch: 1;
                small: true;
                kind: ButtonKind.danger;
                icon: Icons.log-out;
                text: @tr("Leave");
                clicked => { Bridge.leave-stream(); }
            }
        }
        if stream.id == "": Spinner {
            size: 16px;
        }
    }
}

// The right panel of a server: who is in our channel, the streams there,
// and requests to watch ours.
export component StreamsPanel inherits VerticalLayout {
    padding: Theme.space-4;
    spacing: Theme.space-3;
    HorizontalLayout {
        Text {
            text: Bridge.own-channel != "" ? @tr("In voice — {} ({})", Bridge.own-channel, Bridge.members.length) : @tr("Members");
            font-size: Theme.font-lg;
            font-weight: Theme.weight-semibold;
            color: Theme.text;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }
        IconButton {
            icon: Icons.x;
            label: @tr("Close the panel");
            size: 28px;
            icon-size: Theme.icon-sm;
            clicked => { Nav.right-panel-open = false; }
        }
    }
    if Bridge.members.length == 0: Text {
        text: @tr("Join a channel with voice to see who is there.");
        color: Theme.text-muted;
        font-size: Theme.font-sm;
        wrap: word-wrap;
    }
    sv := ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            width: sv.visible-width;
            spacing: Theme.space-2;
            alignment: start;
            for member in Bridge.members: VerticalLayout {
                if member.first-in-group: GroupHeader {
                    member: member;
                }
                MemberRow {
                    member: member;
                }
            }
            if Bridge.streams-available: VerticalLayout {
                padding-top: Theme.space-4;
                spacing: Theme.space-3;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    SectionHeader {
                        text: @tr("Streams");
                        icon: Icons.radio;
                        count: Bridge.streams.length;
                        small: true;
                    }
                    if Bridge.share-state == "live": VerticalLayout {
                        alignment: center;
                        LiveBadge { text: @tr("YOU ARE LIVE"); }
                    }
                }
                if Bridge.streams.length == 0: Text {
                    text: @tr("No streams in your channel.");
                    color: Theme.text-muted;
                    font-size: Theme.font-sm;
                }
                for stream in Bridge.streams: StreamCard {
                    stream: stream;
                }
                if Bridge.share-state == "live" || Bridge.share-state == "starting": Button {
                    icon: Icons.users;
                    text: Bridge.share-requests > 0 ? @tr("Viewers ({})", Bridge.share-requests) : @tr("Manage");
                    kind: Bridge.share-requests > 0 ? ButtonKind.primary : ButtonKind.secondary;
                    clicked => { Nav.open-share(); }
                }
                for viewer in Bridge.share-viewers: HorizontalLayout {
                    spacing: Theme.space-2;
                    if viewer.state == "requested": Text {
                        text: @tr("{} wants to watch", viewer.name);
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Theme.warning;
                    }
                    if viewer.state == "requested": Button {
                        small: true;
                        kind: ButtonKind.primary;
                        text: @tr("Accept");
                        clicked => { Bridge.respond-viewer(viewer.client, true); }
                    }
                    if viewer.state == "requested": Button {
                        small: true;
                        text: @tr("Deny");
                        clicked => { Bridge.respond-viewer(viewer.client, false); }
                    }
                }
            }
        }
    }
}

// The player: title bar, picture and controls (no chat).
component StreamPlayer inherits Rectangle {
    background: Theme.dark ? #03060f : #0b1330;
    VerticalLayout {
        // Title bar.
        Rectangle {
            height: 64px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: Theme.space-5;
                padding-right: Theme.space-4;
                spacing: Theme.space-4;
                VerticalLayout {
                    alignment: center;
                    Avatar {
                        size: 40px;
                        initials: "";
                        tint: Theme.accent-soft;
                        label: Bridge.viewer-title;
                        Icon {
                            source: Icons.monitor-up;
                            tint: #ffffff;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: Bridge.viewer-title;
                        color: Theme.text;
                        font-size: Theme.font-md;
                        font-weight: Theme.weight-semibold;
                        overflow: elide;
                    }
                    Text {
                        text: Bridge.viewer-info;
                        color: Theme.text-muted;
                        font-size: Theme.font-sm;
                        overflow: elide;
                    }
                }
                // How long we have been watching, and how many others do.
                if !Bridge.viewer-ended: HorizontalLayout {
                    spacing: Theme.space-3;
                    alignment: center;
                    if Bridge.viewer-elapsed != "": HorizontalLayout {
                        spacing: Theme.space-2;
                        Icon {
                            source: Icons.clock;
                            size: 14px;
                            tint: Theme.text-muted;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: Bridge.viewer-elapsed;
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                        }
                    }
                    if Bridge.viewer-count > 0: HorizontalLayout {
                        spacing: Theme.space-2;
                        Icon {
                            source: Icons.eye;
                            size: 14px;
                            tint: Theme.text-muted;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: Bridge.viewer-count;
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                            accessible-label: @tr("viewers");
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        LiveBadge { large: true; }
                    }
                }
            }
        }
        // Picture.
        Rectangle {
            vertical-stretch: 1;
            Image {
                width: parent.width;
                height: parent.height;
                source: Bridge.viewer-frame;
                image-fit: contain;
                visible: Bridge.viewer-has-frame;
                accessible-role: AccessibleRole.image;
                accessible-label: @tr("Stream picture");
            }
            if Bridge.viewer-status != "": Rectangle {
                width: min(parent.width - 32px, status-text.preferred-width + 40px);
                height: status-text.preferred-height + 24px;
                border-radius: Theme.radius-lg;
                background: Theme.overlay;
                border-width: 1px;
                border-color: Theme.border-strong;
                status-text := Text {
                    width: min(root.width - 72px, self.preferred-width);
                    text: Bridge.viewer-status;
                    color: #ffffff;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    accessible-live-region: polite;
                }
            }
        }
        // Controls.
        Rectangle {
            height: 52px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                spacing: Theme.space-3;
                IconButton {
                    icon: Bridge.viewer-volume > 0 ? Icons.volume-2 : Icons.volume-x;
                    label: Bridge.viewer-volume > 0 ? @tr("Mute") : @tr("Unmute");
                    size: 30px;
                    icon-size: Theme.icon-sm;
                    y: (parent.height - self.height) / 2;
                    clicked => { Bridge.set-stream-volume(Bridge.viewer-volume > 0 ? 0 : 100); }
                }
                Slider {
                    width: 120px;
                    horizontal-stretch: 0;
                    y: (parent.height - self.height) / 2;
                    minimum: 0;
                    maximum: 200;
                    step: 5;
                    value <=> Bridge.viewer-volume;
                    enabled: !Bridge.viewer-ended;
                    label: @tr("Stream volume");
                    changed(v) => { Bridge.set-stream-volume(v); }
                }
                Text {
                    text: @tr("{}%", round(Bridge.viewer-volume));
                    width: 44px;
                    vertical-alignment: center;
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                }
                // Simulcast layers the streamer offers; "Auto" follows the
                // bandwidth estimate.
                if Bridge.viewer-qualities.length > 1: Select {
                    width: 150px;
                    horizontal-stretch: 0;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.sliders-horizontal;
                    label: @tr("Quality");
                    model: Bridge.viewer-qualities;
                    current-index <=> Bridge.viewer-quality;
                    enabled: !Bridge.viewer-ended;
                    selected(_) => { Bridge.set-stream-quality(Bridge.viewer-quality); }
                }
                if Bridge.viewer-quality == 0 && Bridge.viewer-quality-detail != "": Text {
                    text: Bridge.viewer-quality-detail;
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton {
                    icon: Icons.external-link;
                    label: Bridge.viewer-popped ? @tr("Back to the window") : @tr("Pop out");
                    checked: Bridge.viewer-popped;
                    y: (parent.height - self.height) / 2;
                    clicked => { Bridge.viewer-popped = !Bridge.viewer-popped; }
                }
                IconButton {
                    icon: Bridge.viewer-fullscreen ? Icons.minimize-2 : Icons.maximize;
                    label: Bridge.viewer-fullscreen ? @tr("Exit full screen") : @tr("Full screen");
                    y: (parent.height - self.height) / 2;
                    clicked => { Bridge.toggle-fullscreen(); }
                }
                if !Bridge.viewer-fullscreen: Button {
                    small: true;
                    icon: Icons.message-square;
                    text: @tr("Chat");
                    accessible-label: @tr("Back to the chat");
                    y: (parent.height - self.height) / 2;
                    clicked => { Bridge.hide-viewer(); }
                }
                Button {
                    small: true;
                    kind: ButtonKind.danger;
                    icon: Icons.log-out;
                    text: Bridge.viewer-ended ? @tr("Close") : @tr("Leave");
                    y: (parent.height - self.height) / 2;
                    clicked => { Bridge.leave-stream(); }
                }
            }
        }
    }
}

// The chat beside the player: the current chat's messages and a composer.
component StreamChat inherits Rectangle {
    background: Theme.surface;
    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.border;
    }
    VerticalLayout {
        Rectangle {
            height: 44px;
            HorizontalLayout {
                padding-left: Theme.space-4;
                padding-right: Theme.space-3;
                spacing: Theme.space-2;
                Icon {
                    source: Icons.message-square;
                    size: Theme.icon-sm;
                    tint: Theme.text-secondary;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: Bridge.current-tab >= 0 && Bridge.current-tab < Bridge.tabs.length ? Bridge.tabs[Bridge.current-tab].title : @tr("Chat");
                    color: Theme.text;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }
        ListView {
            vertical-stretch: 1;
            accessible-label: @tr("Messages");
            for line in Bridge.messages: MessageRow {
                line: line;
                actions: false;
            }
        }
        HorizontalLayout {
            padding: Theme.space-3;
            Rectangle {
                min-height: 40px;
                border-radius: Theme.radius-lg;
                background: Theme.surface-2;
                border-width: 1px;
                border-color: field.has-focus ? Theme.accent : Theme.border;
                HorizontalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-2;
                    field := TextField {
                        text <=> Nav.draft;
                        bare: true;
                        placeholder: @tr("Message");
                        label: @tr("Message");
                        accepted(text) => {
                            if text != "" {
                                Bridge.send-message(text);
                                self.clear();
                            }
                        }
                    }
                    IconButton {
                        icon: Icons.send;
                        label: @tr("Send");
                        round: true;
                        enabled: field.text != "";
                        tint: field.text != "" ? Theme.on-accent : Theme.text-muted;
                        filled: field.text != "";
                        y: (parent.height - self.height) / 2;
                        clicked => {
                            if field.text != "" {
                                Bridge.send-message(field.text);
                                field.clear();
                            }
                        }
                    }
                }
            }
        }
    }
}

// The stream we watch: the player, with the chat beside it when there is
// room (and not in full screen).
export component StreamViewer inherits Rectangle {
    background: Theme.dark ? #03060f : #0b1330;
    // Reading our own width here would loop through the layout, so the
    // phone breakpoint (a setting) decides.
    property <bool> with-chat: !Bridge.viewer-fullscreen && !Nav.narrow;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: @tr("Stream viewer");
    HorizontalLayout {
        StreamPlayer {
            horizontal-stretch: 1;
        }
        if root.with-chat: StreamChat {
            width: Nav.right-panel-width + 40px;
            horizontal-stretch: 0;
        }
    }
}
