// The home page: a welcome banner, who is online on the current server,
// its chats with their last message, the servers, and the streams of our
// channel (design mockups 01, desktop and phone).

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Bridge, ServerItem, MemberItem, StreamItem, ChatTab } from "../bridge.slint";
import { Nav, Page, MobileTab, SettingsSection } from "../nav.slint";
import { Icon, Button, ButtonKind, Avatar, Status, Chip, SectionHeader, NavItem, Divider, CountBadge, LiveBadge, ScrollView } from "../components/index.slint";

// The sidebar next to the home page.
export component HomeNav inherits VerticalLayout {
    spacing: Theme.space-2;
    NavItem {
        icon: Icons.home;
        text: @tr("Home");
        selected: true;
    }
    NavItem {
        icon: Icons.server;
        text: @tr("Servers");
        badge: 0;
        clicked => { Nav.show(Page.server); }
    }
    NavItem {
        icon: Icons.settings;
        text: @tr("Settings");
        clicked => { Nav.open-settings(SettingsSection.voice); }
    }
    VerticalLayout {
        padding-top: Theme.space-5;
        padding-left: Theme.space-3;
        padding-bottom: Theme.space-2;
        Text {
            text: @tr("Quick Actions");
            font-size: Theme.font-sm;
            font-weight: Theme.weight-semibold;
            color: Theme.text-secondary;
        }
    }
    NavItem {
        icon: Icons.plus;
        text: @tr("Add a server");
        clicked => { Nav.add-server(); }
    }
    NavItem {
        icon: Icons.info;
        text: @tr("About {}", Bridge.app-name);
        clicked => { Nav.open-about(); }
    }
}

// A server as a card with its state and a button to open it.
component ServerCard inherits Rectangle {
    in property <ServerItem> server;
    min-width: 220px;
    max-width: 340px;
    horizontal-stretch: 1;
    height: 132px;
    border-radius: Theme.radius-lg;
    clip: true;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: area.has-hover ? Theme.border-strong : Theme.border;
    accessible-role: AccessibleRole.list-item;
    accessible-label: server.name;
    accessible-description: server.address;
    accessible-action-default => { Nav.select-server(server.id); }
    area := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { Nav.select-server(root.server.id); }
    }
    Rectangle {
        height: 56px;
        y: 0;
        background: @linear-gradient(120deg, root.server.tint 0%, root.server.tint.darker(0.6) 100%);
        opacity: 0.8;
    }
    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-2;
        HorizontalLayout {
            spacing: Theme.space-3;
            Avatar {
                size: 52px;
                square: true;
                initials: root.server.initials;
                tint: root.server.tint;
                label: root.server.name;
                status: root.server.status == "connected" ? Status.online : root.server.status == "observing" ? Status.info : root.server.status == "connecting" ? Status.idle : Status.none;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.server.live: VerticalLayout {
                alignment: start;
                LiveBadge { }
            }
            if root.server.unread > 0: VerticalLayout {
                alignment: start;
                CountBadge { count: root.server.unread; }
            }
        }
        Rectangle { vertical-stretch: 1; }
        Text {
            text: root.server.name;
            color: Theme.text;
            font-size: Theme.font-md;
            font-weight: Theme.weight-semibold;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            Rectangle {
                width: 8px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: root.server.status == "connected" ? Theme.success : root.server.status == "observing" ? Theme.info : root.server.status == "connecting" ? Theme.warning : Theme.offline;
            }
            Text {
                text: root.server.status == "connected" ? @tr("Connected") : root.server.status == "observing" ? @tr("Observing") : root.server.status == "connecting" ? @tr("Connecting…") : root.server.address;
                color: Theme.text-muted;
                font-size: Theme.font-sm;
                overflow: elide;
            }
        }
    }
}

// Someone on the current server (the "Online now" row); a tap opens their
// card.
component PersonChip inherits VerticalLayout {
    in property <MemberItem> member;
    width: 76px;
    spacing: Theme.space-1;
    accessible-role: AccessibleRole.list-item;
    accessible-label: member.name;
    accessible-description: member.status;
    accessible-action-default => { Bridge.open-member(member.id); }
    HorizontalLayout {
        alignment: center;
        Avatar {
            size: 56px;
            initials: member.initials;
            tint: member.tint;
            image: member.avatar;
            label: member.name;
            speaking: member.talking;
            crown: member.admin;
            status: member.away ? Status.idle : member.streaming ? Status.info : Status.online;
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { Bridge.open-member(member.id); }
            }
        }
    }
    Text {
        text: member.name;
        color: Theme.text;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        overflow: elide;
    }
    Text {
        text: member.status;
        color: member.streaming ? Theme.live : Theme.text-muted;
        font-size: Theme.font-xs;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// A stream of our channel (the "Live now" row): LIVE, viewers, the title,
// who; a tap watches it.
component LiveCard inherits Rectangle {
    in property <StreamItem> stream;
    width: 224px;
    height: 136px;
    border-radius: Theme.radius-lg;
    clip: true;
    background: @linear-gradient(160deg, #26237a 0%, #0c1430 100%);
    border-width: 1px;
    border-color: stream.watching ? Theme.accent : area.has-hover ? Theme.border-strong : Theme.border;
    accessible-role: AccessibleRole.button;
    accessible-label: stream.name;
    accessible-action-default => { area.watch(); }
    area := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        function watch() {
            if stream.id == "" || stream.own {
                return;
            }
            Nav.show(Page.server);
            if stream.watching {
                Bridge.show-viewer();
            } else {
                Bridge.watch-stream(stream.id);
            }
        }
        clicked => { self.watch(); }
    }
    Icon {
        source: stream.kind == "Camera" ? Icons.video : Icons.monitor-up;
        size: 56px;
        tint: #ffffff1c;
    }
    HorizontalLayout {
        x: Theme.space-3;
        y: Theme.space-3;
        height: 22px;
        spacing: Theme.space-2;
        LiveBadge {
            y: (parent.height - self.height) / 2;
        }
        if stream.viewers > 0: Chip {
            text: stream.viewers;
            icon: Icons.eye;
            tint: #ffffff;
            fill: #060a18a0;
            y: (parent.height - self.height) / 2;
        }
    }
    VerticalLayout {
        padding: Theme.space-3;
        alignment: end;
        spacing: 1px;
        Text {
            text: stream.id == "" ? @tr("{} is streaming", stream.streamer) : stream.name != "" ? stream.name : @tr("Untitled stream");
            color: #ffffff;
            font-weight: Theme.weight-semibold;
            overflow: elide;
        }
        Text {
            text: stream.channel != "" ? stream.streamer + "  •  " + stream.channel
                : stream.kind != "" ? stream.streamer + "  •  " + stream.kind : stream.streamer;
            color: #ffffffb0;
            font-size: Theme.font-sm;
            overflow: elide;
        }
    }
}

// A chat of the current server with its last message ("Chats"); a tap
// opens it.
component ChatRow inherits Rectangle {
    in property <ChatTab> tab;
    in property <int> index;
    height: 60px;
    border-radius: Theme.radius-lg;
    background: area.has-hover ? Theme.surface-3 : Theme.surface-2;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: AccessibleRole.button;
    accessible-label: tab.title;
    accessible-description: tab.last;
    accessible-action-default => { area.open(); }
    area := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        function open() {
            Bridge.select-tab(root.index);
            Nav.mobile-tab = MobileTab.chat;
            Nav.show(Page.server);
        }
        clicked => { self.open(); }
    }
    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;
        Rectangle {
            width: 40px;
            height: 40px;
            y: (parent.height - self.height) / 2;
            border-radius: 20px;
            background: Theme.surface-4;
            Icon {
                source: tab.kind == 1 ? Icons.hash : tab.kind == 2 ? Icons.at-sign : Icons.message-square;
                size: Theme.icon-md;
                tint: Theme.accent-text;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;
            HorizontalLayout {
                spacing: Theme.space-3;
                Text {
                    text: tab.title;
                    color: Theme.name-text;
                    font-weight: Theme.weight-semibold;
                    overflow: elide;
                    max-width: self.preferred-width;
                }
                Text {
                    text: tab.time;
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: tab.last != "" ? tab.last : @tr("No messages yet");
                color: tab.last != "" ? Theme.text-secondary : Theme.text-muted;
                font-size: Theme.font-sm;
                overflow: elide;
            }
        }
        if tab.unread > 0: CountBadge {
            count: tab.unread;
            fill: Theme.accent;
            y: (parent.height - self.height) / 2;
        }
        Icon {
            source: Icons.chevron-right;
            size: Theme.icon-sm;
            tint: Theme.text-muted;
            y: (parent.height - self.height) / 2;
        }
    }
}

export component HomePage inherits Rectangle {
    sv := ScrollView {
        VerticalLayout {
            width: sv.visible-width;
            padding: Nav.narrow ? Theme.space-4 : Theme.space-6;
            spacing: Nav.narrow ? Theme.space-5 : Theme.space-6;
            alignment: start;
            // Welcome banner.
            Rectangle {
                // Wrapped text is measured at an unknown width: room
                // for it on the phone.
                min-height: Nav.narrow ? 236px : 220px;
                border-radius: Theme.radius-xl;
                clip: true;
                background: @linear-gradient(115deg, #0e1d5c 0%, #1c1470 45%, #3a1f86 75%, #0b2a6b 100%);
                border-width: 1px;
                border-color: Theme.border-strong;
                // A moon: soft rings (the software renderer clips no
                // gradients to circles).
                for ring[i] in [
                    { size: 190px, color: #7f95ff14 },
                    { size: 160px, color: #8fa4ff26 },
                    { size: 132px, color: #a9b9ff5a },
                    { size: 118px, color: #c4d0ffa0 },
                ]: Rectangle {
                    x: parent.width - 180px - ring.size / 2;
                    y: 100px - ring.size / 2;
                    width: ring.size;
                    height: ring.size;
                    border-radius: ring.size / 2;
                    background: ring.color;
                    // Behind the text in narrow windows.
                    visible: parent.width > 640px;
                }
                for star[i] in [
                    { x: 0.55, y: 0.18 }, { x: 0.62, y: 0.52 }, { x: 0.71, y: 0.1 }, { x: 0.9, y: 0.3 },
                    { x: 0.95, y: 0.75 }, { x: 0.83, y: 0.86 }, { x: 0.6, y: 0.8 }, { x: 0.5, y: 0.6 },
                ]: Rectangle {
                    x: parent.width * star.x;
                    y: parent.height * star.y;
                    width: mod(i, 3) == 0 ? 3px : 2px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: #ffffffc0;
                }
                VerticalLayout {
                    padding: Nav.narrow ? Theme.space-5 : Theme.space-7;
                    spacing: Theme.space-3;
                    alignment: center;
                    HorizontalLayout {
                        spacing: Theme.space-4;
                        alignment: start;
                        Image {
                            width: Nav.narrow ? 40px : 52px;
                            height: self.width;
                            source: Icons.logo;
                        }
                        Text {
                            text: Bridge.app-name;
                            color: #ffffff;
                            font-size: (Nav.narrow ? 30px : 40px) * Theme.font-scale;
                            font-weight: Theme.weight-bold;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: @tr("Voice, chat and streams on TeamSpeak servers.");
                        color: #ffffff;
                        font-size: Theme.font-xl;
                        font-weight: Theme.weight-medium;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Talk. Watch. Share. Or look in without joining.");
                        color: #c9d4ff;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-3;
                        Button {
                            kind: ButtonKind.primary;
                            icon: Icons.plus;
                            text: @tr("Add a server");
                            clicked => { Nav.add-server(); }
                        }
                        if Bridge.servers.length > 0: Button {
                            icon: Icons.arrow-right;
                            text: Nav.narrow ? @tr("Open") : @tr("Open {}", Bridge.server-title);
                            clicked => { Nav.show(Page.server); }
                        }
                    }
                }
            }
            // Who is on the current server.
            if Bridge.server-members.length > 0: SectionHeader {
                text: @tr("Online now");
                icon: Icons.users;
                count: Bridge.server-members.length;
                action: @tr("See All");
                action-clicked => {
                    Nav.show(Page.server);
                    if Nav.narrow {
                        Nav.members-open = true;
                    } else {
                        Nav.right-panel-open = true;
                    }
                }
            }
            if Bridge.server-members.length > 0: ScrollView {
                height: 118px;
                HorizontalLayout {
                    // Room for the crowns.
                    padding-top: 6px;
                    spacing: Theme.space-2;
                    alignment: start;
                    for member in Bridge.server-members: PersonChip {
                        member: member;
                    }
                }
            }
            // The current server's chats with their last message.
            if Bridge.current-server >= 0 && Bridge.tabs.length > 0: SectionHeader {
                text: @tr("Chats");
                icon: Icons.message-square;
                count: Bridge.unread-total > 0 ? Bridge.unread-total : "";
                action: @tr("See All");
                action-clicked => {
                    Nav.mobile-tab = MobileTab.chat;
                    Nav.show(Page.server);
                }
            }
            if Bridge.current-server >= 0: VerticalLayout {
                spacing: Theme.space-2;
                for tab[i] in Bridge.tabs: ChatRow {
                    tab: tab;
                    index: i;
                }
            }
            SectionHeader {
                text: @tr("Your servers");
                icon: Icons.server;
                count: Bridge.servers.length;
                action: @tr("Add");
                action-clicked => { Nav.add-server(); }
            }
            if Bridge.servers.length == 0: Text {
                text: @tr("No servers yet. Add one with its address and your nickname.");
                color: Theme.text-muted;
            }
            // The phone scrolls them sideways.
            if Nav.narrow && Bridge.servers.length > 0: ScrollView {
                height: 140px;
                HorizontalLayout {
                    spacing: Theme.space-3;
                    alignment: start;
                    for server in Bridge.servers: ServerCard {
                        width: 236px;
                        server: server;
                    }
                }
            }
            if !Nav.narrow: FlexboxLayout {
                spacing: Theme.space-4;
                alignment: stretch;
                for server in Bridge.servers: ServerCard {
                    server: server;
                }
            }
            // The streams on the server, ours first.
            if Bridge.streams.length > 0: SectionHeader {
                text: @tr("Live now");
                icon: Icons.radio;
                count: Bridge.streams.length;
            }
            if Bridge.streams.length > 0: ScrollView {
                height: 140px;
                HorizontalLayout {
                    spacing: Theme.space-3;
                    alignment: start;
                    for stream in Bridge.streams: LiveCard {
                        stream: stream;
                    }
                }
            }
        }
    }
}
