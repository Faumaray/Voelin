import { Theme } from "../theme.slint";

// Native artwork keeps its pixel size; resized artwork gets an aspect-aware
// area. Bound unusually tall pictures so navigation remains usable.
export global BannerLayout {
    public pure function artwork-height(source: image, width: length, mode: int, limit: length) -> length {
        return source.width <= 0 ? 0px : min(limit, max(32px,
            mode == 0 ? source.height * 1px : width * source.height / source.width));
    }
}

// Artwork has its own area: titles and controls use the solid surface below.
// Wire modes: 0 native (centred), 1 stretched, 2 aspect-preserving fit.
export component BannerPicture inherits Rectangle {
    in property <image> source;
    in property <int> mode;
    clip: true;
    background: Theme.surface-2;
    accessible-role: AccessibleRole.none;
    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: root.mode == 1 ? ImageFit.fill : root.mode == 2 ? ImageFit.contain : ImageFit.preserve;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: AccessibleRole.none;
    }
}
