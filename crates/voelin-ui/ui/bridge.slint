// The data Rust gives the UI and the callbacks it handles. Models are
// VecModels that Rust updates row by row (src/vm/), so screens can bind to
// them freely.

export struct ServerItem {
    id: int,
    name: string,
    address: string,
    // "offline", "connecting", "observing" or "connected"
    status: string,
    // Avatar of a server without an icon.
    initials: string,
    tint: color,
    // Unread messages in its chats.
    unread: int,
    // Someone streams in our channel there.
    live: bool,
    // "9 online · 7 channels" while its presence is known, else the address.
    detail: string,
    // "TeamSpeak 6", "TeamSpeak 3", "" before it was reached.
    flavor: string,
    // Gateway or query credentials: presence without joining.
    gateway: bool,
}

export struct TreeItem {
    is-channel: bool,
    depth: int,
    id: int,
    name: string,
    own: bool,
    talking: bool,
    muted: bool,
    sound-off: bool,
    away: bool,
    streaming: bool,
    locked: bool,
    collapsed: bool,
    // Local playback of this client: muted, or its volume in percent
    // (100 = unchanged).
    local-muted: bool,
    local-volume: int,
    // Our own client.
    myself: bool,
    // Avatar of a client.
    initials: string,
    tint: color,
    // The client's avatar picture, empty without one.
    avatar: image,
    // Channels: clients inside, and the limit (-1: none).
    members: int,
    max-members: int,
}

// A client for the members panel (everyone on the server) and the voice
// channel view (our channel).
export struct MemberItem {
    id: int,
    name: string,
    initials: string,
    tint: color,
    avatar: image,
    talking: bool,
    muted: bool,
    sound-off: bool,
    away: bool,
    streaming: bool,
    myself: bool,
    // "Speaking", "Streaming", "Away", ...
    status: string,
    // The away message, empty without one.
    away-message: string,
    // The section the row is in (a server group, "In Voice",
    // "Streaming"), and the group's icon.
    group: string,
    group-icon: image,
    // The first row of its section draws the heading, with the number of
    // rows in the section.
    first-in-group: bool,
    group-count: int,
    // Badges: a crown for the server's admin groups.
    admin: bool,
    // A moderator group's name, shown as a role next to the name.
    role: string,
    priority: bool,
    commander: bool,
    recording: bool,
    // `client_talk_power`; shown when the channel needs it.
    talk-power: int,
}

// The member card over a member row: everything about one client and what
// can be done with them.
export struct MemberCard {
    open: bool,
    id: int,
    name: string,
    initials: string,
    tint: color,
    avatar: image,
    status: string,
    description: string,
    // Server groups, one per line.
    groups: [string],
    country: string,
    talk-power: int,
    friend: bool,
    blocked: bool,
    // Local playback, in percent.
    volume: float,
    muted: bool,
    // The client has a unique id, so contacts and private chats work.
    known: bool,
}

export struct ChatTab {
    // "#Lobby", "@alice", "Server"
    title: string,
    // The name alone ("Lobby").
    name: string,
    // 0 = server chat, 1 = channel chat, 2 = private chat
    kind: int,
    id: int,
    unread: int,
    // The channel's topic (channel chats).
    topic: string,
}

// A piece of a chat line: text, or an emoji shown as an image (`emoji` is
// its Twemoji key, e.g. "1f600"; `text` then holds the characters).
export struct TextRun {
    text: string,
    emoji: string,
}

// One emoji under a message, with how many put it there.
export struct ReactionItem {
    // The Twemoji key of the first emoji in `text` ("1f389"), for the image.
    key: string,
    text: string,
    count: int,
    // We reacted with it.
    me: bool,
}

// A file linked in a message (`ChatMessage::file_refs`).
export struct FileItem {
    name: string,
    // "2.4 MB", or what the transfer is doing.
    detail: string,
    // Index of the link in the message (what `download-file` takes).
    index: int,
    // "", "running", "done", "failed"
    state: string,
    // 0 … 1 while it downloads.
    progress: float,
    // A picture, so the icon differs.
    picture: bool,
    // The picture itself, once downloaded: shown inline instead of the card.
    preview: image,
}

export struct ChatLine {
    // A handle for this message in its chat, stable while the chat is open
    // (the engine's ids do not fit a Slint int).
    key: int,
    author: string,
    text: string,
    time: string,
    relayed: bool,
    // The text split into runs; only filled when it has emoji (`rich`).
    runs: [TextRun],
    rich: bool,
    // Only one to three emoji: shown large.
    jumbo: bool,
    // Same author as the line before, shortly after: no header.
    continued: bool,
    initials: string,
    tint: color,
    avatar: image,
    // From a blocked contact.
    blocked: bool,
    pinned: bool,
    reactions: [ReactionItem],
    files: [FileItem],
    // The gateway knows this message: it can be pinned, reacted to and
    // made into a topic.
    remote: bool,
    // The topic it belongs to, "" outside a topic.
    topic: string,
    // Highlighted after jumping to it from the pins.
    marked: bool,
}

// A pinned message in the pins drawer.
export struct PinItem {
    line: ChatLine,
    // "pinned by Nova · 12:04"
    by: string,
}

// A gateway topic (thread).
export struct TopicItem {
    id: int,
    title: string,
    creator: string,
    // "12 messages · by Nova"
    detail: string,
    // "Last active 3 min ago", and whether that was within the hour.
    activity: string,
    recent: bool,
    archived: bool,
}

export struct BookmarkForm {
    id: int,
    name: string,
    address: string,
    nickname: string,
    server-password: string,
    gateway-url: string,
    query-transport: string,
    query-addr: string,
    query-user: string,
    query-password: string,
}

// A stream in our channel. An empty id: a client that streams, but whose
// stream is still being looked up (it started before we joined).
export struct StreamItem {
    id: string,
    name: string,
    streamer: string,
    // The streamer's client id (their avatar in the members).
    streamer-id: int,
    // How many watch it (the gateway's directory; 0 unknown).
    viewers: int,
    audio: bool,
    // "Screen", "Window", "Camera"; and the announced bitrate ("8 Mbit/s").
    kind: string,
    bitrate: string,
    // Shown in the viewer.
    watching: bool,
    // Our own stream.
    own: bool,
}

// A viewer of our stream. state: "requested", "connecting" or "connected".
export struct ViewerItem {
    client: int,
    name: string,
    state: string,
    message: string,
}

// A capture source for the share dialog.
export struct SourceItem {
    name: string,
    detail: string,
}

export struct ShareForm {
    source: int,
    name: string,
    // Index into the frame rate choices (15, 30, 60).
    fps-index: int,
    // Frames per second as typed; a choice fills it in. Any number above 0.
    fps: string,
    // Index into the bitrate choices (2.5, 4.6, 8, 10 Mbit/s).
    bitrate-index: int,
    // Video bitrate in kbit/s as typed; a choice fills it in.
    bitrate: string,
    audio: bool,
    auto-accept: bool,
}

export struct AudioForm {
    // 0 = system default, then the devices.
    input-index: int,
    output-index: int,
    // 0 = push-to-talk, 1 = voice activation, 2 = continuous.
    transmit: int,
    // dBFS.
    vad-threshold: float,
    echo-cancellation: bool,
    noise-suppression: bool,
    // 0 = low ... 3 = very high.
    noise-level: int,
    auto-gain: bool,
    // dB.
    input-gain: float,
    // Percent.
    output-volume: float,
    // Milliseconds.
    playback-buffer: float,
}

// Local playback settings of one client. volume in percent.
export struct ClientAudio {
    id: int,
    name: string,
    volume: float,
    muted: bool,
}

// The appearance settings (`ui.*` keys).
export struct AppearanceForm {
    // "dark", "light" or "system"
    theme: string,
    font-scale: float,
    // Pixels.
    narrow-breakpoint: float,
    image-cache-mb: float,
}

// Home, friends, direct messages, notifications, search, events and the
// settings pages (docs/ui.md). Lists are models Rust syncs row by row.

// A contact (friend, blocked or neutral) and where they are now.
export struct ContactItem {
    uid: string,
    name: string,
    initials: string,
    tint: color,
    avatar: image,
    // "friend", "blocked" or "neutral"
    relation: string,
    online: bool,
    away: bool,
    streaming: bool,
    // What they do: "In Chill Zone", "Streaming", "Away: brb", "Offline".
    status: string,
    // Where: the server of the first session that sees them, or "Last seen
    // 2 h ago on Nightfall Guild".
    place: string,
    // "12m ago": online since (this run), else when last seen.
    when: string,
    note: string,
    // Local playback in percent.
    volume: float,
    muted: bool,
    // "Contact since 14 Jan 2022".
    since: string,
    // Every session that sees them: "Nightfall Guild · #Chill Zone".
    spots: [string],
    // A voice connection sees them: they can be messaged, poked, joined.
    reachable: bool,
    selected: bool,
}

// A live stream on one of our servers (home page).
export struct LiveItem {
    // The session (bookmark id) and the stream (directory or stream id).
    session: int,
    id: string,
    title: string,
    streamer: string,
    initials: string,
    tint: color,
    avatar: image,
    server: string,
    channel: string,
    // 0: unknown.
    viewers: int,
    // "Screen", "Camera", ...
    kind: string,
    // The server's colour, for the card's picture.
    backdrop: color,
    // In our voice channel: it can be watched at once.
    watchable: bool,
}

// A chat in the recent chats and in the direct messages list.
export struct ConversationItem {
    // Index in Rust's list (what `open-conversation` takes).
    key: int,
    // 0 server chat, 1 channel chat, 2 private chat, 3 offline message.
    kind: int,
    title: string,
    // The server's name.
    server: string,
    // "You: That works!", "Sent a file".
    preview: string,
    // "11:42", "Yesterday", "Mon", "12 Mar".
    time: string,
    // "10m ago".
    ago: string,
    unread: int,
    initials: string,
    tint: color,
    avatar: image,
    online: bool,
    selected: bool,
}

// A notification of the bell.
export struct NoticeItem {
    key: int,
    // "mention", "poke", "message", "event", "friend"
    kind: string,
    title: string,
    body: string,
    // "3 min ago"
    time: string,
    unread: bool,
    initials: string,
    tint: color,
    avatar: image,
}

// A result of the search (Ctrl+K).
export struct SearchItem {
    // "server", "channel", "person", "contact", "setting"
    kind: string,
    title: string,
    subtitle: string,
    initials: string,
    tint: color,
    avatar: image,
    // The first result of a group names it ("Servers", "People", ...).
    header: string,
}

// Something on our servers: an event, a scheduled stream or server news.
export struct HappeningItem {
    // "event", "stream", "news"
    kind: string,
    title: string,
    subtitle: string,
    // "Sat 26 Apr · 19:00"
    when: string,
    session: int,
    id: int,
    live: bool,
}

// A scheduled event of a server's gateway.
export struct EventItem {
    id: int,
    title: string,
    description: string,
    // The date block: "SAT", "26", "APR".
    weekday: string,
    day: string,
    month: string,
    // "Sat 26 Apr, 19:00 – 21:00"
    when: string,
    // "#Raid Night" or "Server-wide".
    place: string,
    // A scheduled stream: "Exploring the Lands Between · Elden Ring".
    stream: string,
    live: bool,
    going: int,
    maybe: int,
    not-going: int,
    // "going", "maybe", "not_going" or "".
    rsvp: string,
    creator: string,
    // We may edit and delete it (ours, or we moderate).
    editable: bool,
    // "Starts in 15 min", "Started 5 min ago", "".
    soon: string,
    // "Nova (going)", ...; filled once the event was opened.
    attendees: [string],
    expanded: bool,
}

// The event form (create or edit).
export struct EventForm {
    // -1: a new event.
    id: int,
    title: string,
    description: string,
    // "2026-10-04 19:00", local time.
    start: string,
    // Empty: no end.
    end: string,
    // Index into `event-channels` (0: server-wide).
    channel: int,
    stream: bool,
    stream-title: string,
    game: string,
}

// An offline message to write (mail the server keeps).
export struct OfflineForm {
    // The peer's unique id and name.
    uid: string,
    to: string,
    subject: string,
    text: string,
}

// The open direct message: who, and what can be done.
export struct DmPeer {
    open: bool,
    uid: string,
    name: string,
    initials: string,
    tint: color,
    avatar: image,
    online: bool,
    // "Online · Nightfall Guild · #Chill Zone", "Offline · last seen 2 h ago".
    status: string,
    description: string,
    groups: [string],
    note: string,
    since: string,
    // Where they are now, or where they were last seen.
    servers: [string],
    // Files linked in the conversation: "name · 2.4 MB".
    files: [string],
    friend: bool,
    blocked: bool,
    volume: float,
    muted: bool,
    // Messages can be sent now (a voice connection that sees them).
    can-send: bool,
    // Why not: "Kairo is offline.", "Connect to Nightfall Guild to send."
    notice: string,
    // The server keeps offline messages: offer one.
    offline: bool,
    // Connect with voice to the server of this conversation.
    can-connect: bool,
    // The messages come from the store, without a session: read-only.
    stored: bool,
    // An offline message is shown instead of the conversation.
    mail: bool,
    mail-subject: string,
    mail-text: string,
    mail-time: string,
}

// An identity (Profiles page); never its key.
export struct IdentityItem {
    id: int,
    name: string,
    // Unique ids on TeamSpeak 3 and TeamSpeak 6 servers.
    uid: string,
    uid6: string,
    level: int,
    default: bool,
    // Raising its level: the level aimed at and the best one reached (0: no).
    improving: int,
    reached: int,
    // The bookmarks that use it.
    used-by: string,
}

// An identity found in another client's files (import).
export struct FoundIdentity {
    name: string,
    uid: string,
    level: int,
    source: string,
    // Already in our identities.
    known: bool,
    picked: bool,
}

// A bookmark and the identity it connects with (Profiles page).
export struct BookmarkIdentity {
    id: int,
    name: string,
    // Index into `identity-names` (0: the default identity).
    identity: int,
}

// Camera, video and stream quality (Voice & Video page).
export struct VideoForm {
    // Index into `cameras`.
    camera: int,
    // 0 none, 1 blur.
    background: int,
    // "auto", "1280x720", ...
    resolution: string,
    // `stream.fps` as typed.
    fps: string,
    // auto, vp8, vp9, h264, av1.
    codec: int,
    hardware: bool,
    mirror: bool,
    // everyone, friends, channel, nobody.
    permissions: int,
    // 0 auto, 1 720p, 2 1080p, 3 1440p, -1 other layers.
    quality: int,
    // kbit/s.
    bitrate: float,
    // The camera preview runs.
    preview: bool,
}

// A simulcast layer of our stream (Streaming page); numbers as typed.
export struct LayerItem {
    // "1920x1080", or a scale like "0.5".
    size: string,
    // Frames per second; "" no cap.
    fps: string,
    // kbit/s.
    bitrate: string,
    min-bitrate: string,
    max-bitrate: string,
}

// An audio source mixed into our stream.
export struct AudioSourceItem {
    // "desktop", "app", "window", "microphone", "synthetic"
    kind: string,
    name: string,
    detail: string,
    // Percent.
    gain: float,
    muted: bool,
}

// Stream defaults (Streaming page).
export struct StreamingForm {
    fps: string,
    bitrate: string,
    // auto, vp8, vp9, h264, av1.
    codec: int,
    // auto, portal, wlroots, x11.
    capture: int,
    replay-seconds: string,
    replay-memory: string,
    recording-dir: string,
}

// Notification kinds: 0 off, 1 in the app, 2 also on the desktop.
export struct NotifyForm {
    mentions: int,
    pokes: int,
    messages: int,
    events: int,
    friends: int,
}

// Privacy & Safety.
export struct PrivacyForm {
    // 0 hide, 1 show flagged.
    block-mode: int,
    // everyone, friends, nobody.
    messages: int,
    pokes: int,
}

// A server's gateway (Integrations page).
export struct GatewayItem {
    session: int,
    server: string,
    url: string,
    // "connected", "connecting", "off"
    status: string,
    features: [string],
    admin: bool,
}

// A gateway configuration key (gateway administration).
export struct ConfigItem {
    key: string,
    // JSON.
    value: string,
    source: string,
    description: string,
    kind: string,
    bootstrap: bool,
}

// A gateway permission rule.
export struct PermItem {
    action: string,
    // "Everyone", "Server groups 6, 7", "Default: server admins".
    rule: string,
    source: string,
    everyone: bool,
    server-groups: string,
    channel-groups: string,
}

// A video encoder backend (Integrations page).
export struct EncoderItem {
    name: string,
    api: string,
    codec: string,
    hardware: bool,
    ok: bool,
    // Why it does not work, or "used first".
    status: string,
}

// Any registered setting (Advanced page).
export struct SettingItem {
    key: string,
    doc: string,
    // JSON.
    value: string,
    // "set here", "command line", "config file", "default".
    source: string,
}

// A recording or clip of the Stream Studio (Library).
export struct RecordingItem {
    name: string,
    // "12.3 MB · 3 Oct 18:04".
    detail: string,
    clip: bool,
    path: string,
}

// Encoders, chat history, cache and logs (Advanced page); numbers as typed.
export struct AdvancedForm {
    encoder: string,
    hardware: bool,
    store-history: bool,
    history-page: string,
    dedupe-ms: string,
    retention-days: string,
    cache-mb: string,
    fetch-images: bool,
    progress-ms: string,
    // `ui.image_preview_kb`.
    preview-kb: string,
    logs: string,
    crash-dir: string,
}

// Who we are (My Account page).
export struct AccountForm {
    nickname: string,
    identity: string,
    uid: string,
    uid6: string,
    level: int,
    server: string,
}

export global Bridge {
    in property <[ServerItem]> servers;
    in-out property <int> current-server: -1;
    in property <[TreeItem]> tree;
    // Clients in our channel.
    in property <[MemberItem]> members;
    // Everyone on the server, in sections, for the members panel.
    in property <[MemberItem]> server-members;
    // How many people are on the server (not counting query clients).
    in property <int> member-total;
    in property <[ChatTab]> tabs;
    in-out property <int> current-tab: 0;
    in property <[ChatLine]> messages;
    // Older messages can still be loaded in the current chat.
    in property <bool> more-history;
    in property <bool> loading-history;
    // The current chat holds only what this device saw (no gateway sync).
    in property <bool> local-history;
    // Features of the session's gateway: hide what is missing.
    in property <bool> has-pins;
    in property <bool> has-reactions;
    in property <bool> has-topics;
    // The pins drawer.
    in property <[PinItem]> pins;
    in property <bool> pins-loading;
    // The topics drawer, and the open topic.
    in property <[TopicItem]> topics;
    in property <bool> topics-loading;
    in-out property <int> current-topic: -1;
    in property <string> topic-title;
    in property <[ChatLine]> topic-messages;
    // The member card over the members panel.
    in-out property <MemberCard> member-card;
    // Jumping to a pinned message: its row in `messages`, and a counter
    // that changes with every jump.
    in property <int> jump-index: -1;
    in property <int> jump-requests;
    in property <string> status-text;
    // Unread messages in all chats of the current server.
    in property <int> unread-total;
    in property <string> server-title: @tr("No server selected");
    // "12 online · 8 channels"
    in property <string> server-stats;
    // Our nickname on the current server, and the channel we are in.
    in property <string> nickname;
    in property <string> own-channel;
    // Its topic, and how many people it takes (-1: no limit).
    in property <string> own-channel-topic;
    in property <int> own-channel-limit: -1;
    in property <bool> voice-connected;
    in property <bool> voice-connecting;
    in property <bool> observing;
    in property <bool> can-observe;
    in property <bool> input-muted;
    in property <bool> output-muted;
    in property <bool> transmitting;
    in property <string> presence-source;

    // Streams (TeamSpeak 6 while connected with voice).
    in property <bool> streams-available;
    in property <[StreamItem]> streams;
    // Our stream: "", "starting", "live" or "ended".
    in property <string> share-state;
    in property <string> share-status;
    in property <[ViewerItem]> share-viewers;
    in property <int> share-requests;
    in property <[SourceItem]> share-sources;
    in property <string> share-error;
    in property <bool> share-busy;
    // Whether capture and encoding are built in.
    in property <bool> can-share: true;

    // The stream shown in the viewer.
    in property <bool> viewer-open;
    in property <image> viewer-frame;
    in property <bool> viewer-has-frame;
    in property <string> viewer-title;
    // Who streams it (their client id: -1 unknown).
    in property <string> viewer-streamer;
    in property <int> viewer-streamer-id: -1;
    // Shown instead of (or over) the picture: waiting, ended, errors.
    in property <string> viewer-status;
    in property <string> viewer-info;
    in property <bool> viewer-ended;
    in-out property <float> viewer-volume: 100;
    in property <bool> viewer-fullscreen;
    // The viewer fills the window without the shell ("pop out").
    in-out property <bool> viewer-popped;
    // "12:34" since the stream was joined.
    in property <string> viewer-elapsed;
    in property <int> viewer-count;
    // Simulcast layers the streamer offers, "Auto" first.
    in property <[string]> viewer-qualities;
    in-out property <int> viewer-quality: 0;
    // What "Auto" picked ("720p · 2.4 Mbit/s").
    in property <string> viewer-quality-detail;

    // Settings.
    in property <[string]> input-devices;
    in property <[string]> output-devices;
    in-out property <AudioForm> audio;
    // Microphone level in dBFS and whether voice is sent.
    in property <float> input-level: -100;
    in property <bool> input-sending;
    in property <bool> mic-test;
    in-out property <bool> global-ptt;
    in-out property <string> ptt-key;
    in property <string> ptt-status;
    in-out property <bool> h264-enabled;
    in property <bool> h264-loaded;
    in property <bool> h264-busy;
    in property <string> h264-status;
    in property <string> h264-attribution;
    in-out property <AppearanceForm> appearance;
    // "3.2 of 64 MB"
    in property <string> image-cache-usage;
    // The product name (voelin_platform::APP_NAME, not translated) and version.
    in property <string> app-name: "Voelin";
    in property <string> app-version;
    in-out property <ClientAudio> client-audio;
    // Opt-in local crash reports, and a notice about reports on disk.
    in-out property <bool> crash-reports;
    in property <string> crash-notice;
    // Third-party notices, one entry per line, for the About page.
    in property <[string]> notices;

    callback select-server(int);
    // The search field of the top bar: filters the channel tree.
    callback search(string);
    callback connect-voice();
    callback disconnect-voice();
    callback toggle-observe();
    callback join-channel(int);
    callback open-channel-chat(int);
    callback toggle-collapse(int);
    callback select-tab(int);
    callback close-tab(int);
    callback send-message(string);
    // The page before the oldest shown message.
    callback load-older();
    // A message of the current chat, by its `key`.
    callback react(int, string);
    callback pin(int, bool);
    callback download-file(int, int);
    // Attach a file to the current channel chat (opens a file chooser).
    callback attach-file();
    // Pins drawer.
    callback open-pins();
    callback jump-to-pin(int);
    // Topics drawer: load them, open one (-1 closes), post into the open
    // one, start one from a message (by its `key`).
    callback open-topics();
    callback open-topic(int);
    callback send-topic-message(string);
    callback create-topic(int, string);
    // The member card: open it for a client (-1 closes it).
    callback open-member(int);
    callback member-action(string);
    callback member-volume(float);
    callback set-input-muted(bool);
    callback set-output-muted(bool);
    callback push-to-talk(bool);
    callback edit-bookmark(int) -> BookmarkForm;
    callback save-bookmark(BookmarkForm);
    callback delete-bookmark(int);

    callback open-share() -> ShareForm;
    callback start-share(ShareForm);
    callback stop-share();
    callback respond-viewer(int, bool);
    callback kick-viewer(int);
    callback watch-stream(string);
    callback show-viewer();
    callback hide-viewer();
    callback leave-stream();
    callback set-stream-volume(float);
    callback toggle-fullscreen();
    // A simulcast layer of the watched stream (0: Auto).
    callback set-stream-quality(int);

    callback open-settings();
    callback close-settings();
    callback audio-changed(AudioForm);
    callback toggle-mic-test();
    callback apply-ptt(bool, string);
    callback set-h264(bool);
    callback download-h264();
    callback appearance-changed(AppearanceForm);
    // The members panel was dragged to another width (pixels).
    callback panel-resized(float);
    // The voice channel view was opened or closed.
    callback show-voice-view(bool);
    // The members panel's search field.
    callback search-members(string);
    // The topics drawer's search field.
    callback search-topics(string);
    callback open-client(int) -> bool;
    callback client-audio-changed(ClientAudio);
    callback set-crash-reports(bool);
    callback open-crash-folder();
    callback delete-crash-reports();
    callback dismiss-crash-notice();
    callback open-about();

    // Home, friends, direct messages, notifications, search, events and
    // the settings pages.

    // Home: friends online first, live streams on our servers, the latest
    // chats, what friends do, events and server news, the Library.
    in property <[ContactItem]> friends-online;
    in property <[LiveItem]> live-rooms;
    in property <[ConversationItem]> recent-chats;
    in property <[ContactItem]> friend-activity;
    in property <[HappeningItem]> happenings;
    in property <[RecordingItem]> recordings;
    in property <string> recordings-dir;
    callback open-conversation(int);
    // The messages page and the Library were opened.
    callback open-messages();
    callback open-library();
    callback watch-live(int, string);
    callback open-happening(int);
    callback open-recording(string);
    callback open-recordings-folder();
    // Connect a bookmark with voice (the Join buttons).
    callback connect-server(int);

    // Friends: the contacts (friends, then the others), the selected one.
    in property <[ContactItem]> contacts;
    in property <ContactItem> contact;
    in property <int> contacts-online;
    in property <int> contacts-all;
    in property <int> contacts-blocked;
    callback friends-tab(int);
    callback search-contacts(string);
    callback select-contact(string);
    // "message", "poke", "join", "watch", "friend", "block", "neutral",
    // "remove", "mute".
    callback contact-action(string, string);
    callback contact-note(string, string);
    callback contact-volume(string, float);

    // Direct messages: the conversations, the open one (its messages are
    // `messages` while a session holds it, else `dm-messages`).
    in property <[ConversationItem]> conversations;
    in property <int> dm-unread;
    in property <int> inbox-unread;
    in property <DmPeer> dm;
    in property <[ChatLine]> dm-messages;
    callback dm-tab(int);
    callback search-conversations(string);
    // "poke", "join", "friend", "block", "mute", "connect", "delete-mail",
    // "unread-mail".
    callback dm-action(string);
    callback dm-volume(float);
    callback send-offline(OfflineForm);

    // The bell.
    in property <[NoticeItem]> notifications;
    in property <int> notifications-unread;
    callback open-notice(int);
    callback mark-notices-read();
    callback clear-notices();

    // The search (Ctrl+K): `search` fills the results.
    in property <[SearchItem]> search-results;
    callback search-activate(int);

    // A server's events (gateway `events`).
    in property <bool> has-events;
    in property <[EventItem]> events;
    in property <bool> events-loading;
    in property <bool> can-create-events;
    in property <[string]> event-channels;
    callback open-events();
    callback rsvp(int, string);
    callback toggle-event(int);
    callback edit-event(int) -> EventForm;
    callback save-event(EventForm) -> string;
    callback delete-event(int);
    callback watch-event(int);

    // A picture linked in chat, opened larger: the message and the link.
    callback open-preview(int, int) -> image;

    // Settings pages: a section was shown (its data is loaded then).
    callback settings-section(int);
    in property <AccountForm> account;
    in property <[IdentityItem]> identities;
    in property <[string]> identity-names;
    in property <[BookmarkIdentity]> bookmark-identities;
    in property <[FoundIdentity]> found-identities;
    in property <string> identity-status;
    // "default", "delete", "export", "improve", "stop".
    callback identity-action(int, string);
    callback rename-identity(int, string);
    callback improve-target(int, int);
    callback find-identities();
    callback pick-found(int, bool);
    callback import-identities();
    callback bookmark-identity(int, int);

    in-out property <VideoForm> video;
    in property <[string]> cameras;
    in property <image> camera-frame;
    in property <string> camera-status;
    callback video-changed(VideoForm);
    callback toggle-camera-preview();
    callback test-sound();

    in-out property <StreamingForm> streaming;
    in property <[LayerItem]> layers;
    in property <[AudioSourceItem]> audio-sources;
    // Applications that play audio now (for an app source).
    in property <[string]> audio-apps;
    in property <bool> has-studio;
    callback streaming-changed(StreamingForm);
    callback layer-changed(int, LayerItem);
    callback add-layer();
    callback remove-layer(int);
    callback audio-source-changed(int, AudioSourceItem);
    callback add-audio-source(string, string);
    callback remove-audio-source(int);

    in-out property <NotifyForm> notify;
    callback notify-changed(NotifyForm);
    callback test-notification();

    in-out property <PrivacyForm> privacy;
    in property <[ContactItem]> blocked;
    callback privacy-changed(PrivacyForm);

    in property <[GatewayItem]> gateways;
    // The gateway being administered (-1: none) and its keys and rules.
    in property <int> admin-session: -1;
    in property <[ConfigItem]> gateway-config;
    in property <[PermItem]> gateway-perms;
    in property <string> ffmpeg-status;
    in property <string> zero-copy-status;
    in property <[EncoderItem]> encoders;
    in property <bool> encoders-loading;
    callback gateway-admin(int);
    callback config-set(string, string);
    callback config-reset(string);
    callback config-reload();
    callback perm-set(string, bool, string, string);
    callback perm-reset(string);
    callback refresh-encoders();

    in-out property <AdvancedForm> advanced;
    // `stream.srtp_profiles` in order, and those left out.
    in property <[string]> srtp-profiles;
    in property <[string]> srtp-unused;
    in property <[SettingItem]> all-settings;
    in property <[string]> capture-sources;
    callback advanced-changed(AdvancedForm);
    callback srtp-move(int, int);
    callback srtp-toggle(string);
    // A key's JSON value: "" when taken, else why not.
    callback setting-set(string, string) -> string;
    callback setting-reset(string);
    callback search-settings(string);
    callback open-logs();
}

// Decoded images by key, from Rust's image cache (src/images.rs): each is
// decoded once and kept while the cache (setting `ui.image_cache_mb`) has
// room.
export global Images {
    // A Twemoji by key ("1f600", "1f468-200d-1f4bb"); empty if unknown.
    pure callback emoji(string) -> image;
    // The characters of a Twemoji key, to react with or to insert.
    pure callback emoji-text(string) -> string;
}

// One emoji of the picker. `text` is what picking it inserts.
export struct EmojiCell {
    key: string,
    name: string,
    text: string,
}

export struct EmojiRow {
    cells: [EmojiCell],
}

// The emoji picker's data (src/bind/emoji.rs).
export global Emoji {
    // The shown category as rows of `columns` cells.
    in property <[EmojiRow]> rows;
    // The category shown (see EmojiPicker), -1 while searching.
    in-out property <int> category: 0;
    in property <int> columns: 8;
    // Filled once the picker is first opened.
    callback load();
    callback show-category(int);
    callback search(string);
}
